rules_version = '2';

// Paste this into Firebase Console -> Firestore Database -> Rules, then Publish.
//
// Requires anonymous auth (see js/firebaseBookmarks.js) so the database
// isn't wide open to anyone on the internet who obtains your public
// Firebase config values. See the security note at the top of
// js/firebaseBookmarks.js for what this does and doesn't protect against.
service cloud.firestore {
  match /databases/{database}/documents {
    match /bookmarks/{spotifyUserId}/contexts/{contextKey} {
      allow read, write: if request.auth != null;
    }
  }
}
